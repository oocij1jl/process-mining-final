        <dc:Bounds x="2865" y="1085" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Refused_di" bpmnElement="End_Refused">
        <dc:Bounds x="3077" y="1107" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="3035" y="1147" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_Credential_di" bpmnElement="DataObject_Credential">
        <dc:Bounds x="437" y="350" width="36" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="395" y="403" width="120" height="28"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObject_ProhibitedList_di" bpmnElement="DataObject_ProhibitedList">
