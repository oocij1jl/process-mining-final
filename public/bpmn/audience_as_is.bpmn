        <dc:Bounds x="2865" y="185" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Admitted_di" bpmnElement="End_Admitted">
        <dc:Bounds x="3077" y="207" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="3035" y="247" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Reject1_di" bpmnElement="Gw_Reject1" isMarkerVisible="true">
        <dc:Bounds x="1090" y="1100" width="50" height="50"/>
      </bpmndi:BPMNShape>
