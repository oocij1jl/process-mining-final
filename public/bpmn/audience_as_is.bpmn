<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AudienceAsIs" targetNamespace="https://processpilot.example/festival/AudienceAsIs" exporter="generate_festival_logs.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_AudienceAsIs">
    <bpmn:participant id="Participant_AudienceAsIs" name="Audience Entry — North Gate (As-is)" processRef="Process_AudienceAsIs"/>
    <bpmn:participant id="Participant_Attendee" name="Attendee (external)"/>
    <bpmn:messageFlow id="MsgFlow_AttendeeJoins" name="Attendee enters serpentine queue" sourceRef="Participant_Attendee" targetRef="Task_JoinEntryQueue"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AudienceAsIs" name="Audience Entry &amp; Crowd Management (As-is)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AudienceAsIs">
      <bpmn:lane id="Lane_Queue" name="Queue &amp; Entry Record">
        <bpmn:flowNodeRef>Start_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JoinEntryQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntryComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Admitted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TicketLane" name="Ticket Lanes (3 pooled)">
        <bpmn:flowNodeRef>Task_TicketVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ScanOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TicketMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Ticket Support Desk">
        <bpmn:flowNodeRef>Task_ManualTicketCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TicketValid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Steward" name="Wristband Steward">
        <bpmn:flowNodeRef>Gw_ReEntry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WristbandCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WristbandOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WristbandMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security Screener">
        <bpmn:flowNodeRef>Task_SecurityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BagFlagged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SecurityMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Security Supervisor">
        <bpmn:flowNodeRef>Task_AdditionalScreening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Cleared</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Rejection" name="Rejection Record">
        <bpmn:flowNodeRef>Gw_Reject1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reject2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reject3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntryRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refused</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Arrive" name="Attendee reaches entrance">
      <bpmn:outgoing>Flow_A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_JoinEntryQueue" name="Join Entry Queue">
      <bpmn:incoming>Flow_A01</bpmn:incoming>
      <bpmn:outgoing>Flow_A02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_TicketVerification" name="Ticket Verification">
      <bpmn:incoming>Flow_A02</bpmn:incoming>
      <bpmn:outgoing>Flow_A03</bpmn:outgoing>
      <bpmn:property id="Property_Task_TicketVerification" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_Credential_Task_TicketVerification">
        <bpmn:sourceRef>DataObject_Credential</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_TicketVerification</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_ScanOK" name="Credential scanned?">
      <bpmn:incoming>Flow_A03</bpmn:incoming>
      <bpmn:outgoing>Flow_A04</bpmn:outgoing>
      <bpmn:outgoing>Flow_A05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualTicketCheck" name="Manual Ticket Check">
      <bpmn:incoming>Flow_A05</bpmn:incoming>
      <bpmn:outgoing>Flow_A06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_TicketValid" name="Ticket valid?">
      <bpmn:incoming>Flow_A06</bpmn:incoming>
      <bpmn:outgoing>Flow_A07</bpmn:outgoing>
      <bpmn:outgoing>Flow_A08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_TicketMerge" name="">
      <bpmn:incoming>Flow_A04</bpmn:incoming>
      <bpmn:incoming>Flow_A07</bpmn:incoming>
      <bpmn:outgoing>Flow_A09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_ReEntry" name="Re-entry with wristband?">
      <bpmn:incoming>Flow_A09</bpmn:incoming>
      <bpmn:outgoing>Flow_A10</bpmn:outgoing>
      <bpmn:outgoing>Flow_A11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_WristbandCheck" name="Wristband Check">
      <bpmn:incoming>Flow_A10</bpmn:incoming>
      <bpmn:outgoing>Flow_A12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_WristbandOK" name="Wristband intact?">
      <bpmn:incoming>Flow_A12</bpmn:incoming>
      <bpmn:outgoing>Flow_A13</bpmn:outgoing>
      <bpmn:outgoing>Flow_A14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_WristbandMerge" name="">
      <bpmn:incoming>Flow_A11</bpmn:incoming>
      <bpmn:incoming>Flow_A13</bpmn:incoming>
      <bpmn:outgoing>Flow_A15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_SecurityCheck" name="Security Check">
      <bpmn:incoming>Flow_A15</bpmn:incoming>
      <bpmn:outgoing>Flow_A16</bpmn:outgoing>
      <bpmn:property id="Property_Task_SecurityCheck" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_ProhibitedList_Task_SecurityCheck">
        <bpmn:sourceRef>DataObject_ProhibitedList</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_SecurityCheck</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_BagFlagged" name="Bag flagged?">
      <bpmn:incoming>Flow_A16</bpmn:incoming>
      <bpmn:outgoing>Flow_A17</bpmn:outgoing>
      <bpmn:outgoing>Flow_A18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_AdditionalScreening" name="Additional Screening">
      <bpmn:incoming>Flow_A18</bpmn:incoming>
      <bpmn:outgoing>Flow_A19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Cleared" name="Cleared?">
      <bpmn:incoming>Flow_A19</bpmn:incoming>
      <bpmn:outgoing>Flow_A20</bpmn:outgoing>
      <bpmn:outgoing>Flow_A21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_SecurityMerge" name="">
      <bpmn:incoming>Flow_A17</bpmn:incoming>
      <bpmn:incoming>Flow_A20</bpmn:incoming>
      <bpmn:outgoing>Flow_A22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_EntryComplete" name="Entry Complete">
      <bpmn:incoming>Flow_A22</bpmn:incoming>
      <bpmn:outgoing>Flow_A23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Admitted" name="Admitted">
      <bpmn:incoming>Flow_A23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Reject1" name="">
      <bpmn:incoming>Flow_A08</bpmn:incoming>
      <bpmn:outgoing>Flow_A24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Reject2" name="">
      <bpmn:incoming>Flow_A14</bpmn:incoming>
      <bpmn:incoming>Flow_A24</bpmn:incoming>
      <bpmn:outgoing>Flow_A25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Reject3" name="">
      <bpmn:incoming>Flow_A21</bpmn:incoming>
      <bpmn:incoming>Flow_A25</bpmn:incoming>
      <bpmn:outgoing>Flow_A26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EntryRejected" name="Entry Rejected">
      <bpmn:incoming>Flow_A26</bpmn:incoming>
      <bpmn:outgoing>Flow_A27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Refused" name="Entry refused">
      <bpmn:incoming>Flow_A27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A01" sourceRef="Start_Arrive" targetRef="Task_JoinEntryQueue"/>
    <bpmn:sequenceFlow id="Flow_A02" sourceRef="Task_JoinEntryQueue" targetRef="Task_TicketVerification"/>
    <bpmn:sequenceFlow id="Flow_A03" sourceRef="Task_TicketVerification" targetRef="Gw_ScanOK"/>
    <bpmn:sequenceFlow id="Flow_A04" name="yes" sourceRef="Gw_ScanOK" targetRef="Gw_TicketMerge"/>
    <bpmn:sequenceFlow id="Flow_A05" name="no" sourceRef="Gw_ScanOK" targetRef="Task_ManualTicketCheck"/>
    <bpmn:sequenceFlow id="Flow_A06" sourceRef="Task_ManualTicketCheck" targetRef="Gw_TicketValid"/>
    <bpmn:sequenceFlow id="Flow_A07" name="yes" sourceRef="Gw_TicketValid" targetRef="Gw_TicketMerge"/>
    <bpmn:sequenceFlow id="Flow_A08" name="no" sourceRef="Gw_TicketValid" targetRef="Gw_Reject1"/>
    <bpmn:sequenceFlow id="Flow_A09" sourceRef="Gw_TicketMerge" targetRef="Gw_ReEntry"/>
    <bpmn:sequenceFlow id="Flow_A10" name="yes" sourceRef="Gw_ReEntry" targetRef="Task_WristbandCheck"/>
    <bpmn:sequenceFlow id="Flow_A11" name="no" sourceRef="Gw_ReEntry" targetRef="Gw_WristbandMerge"/>
    <bpmn:sequenceFlow id="Flow_A12" sourceRef="Task_WristbandCheck" targetRef="Gw_WristbandOK"/>
    <bpmn:sequenceFlow id="Flow_A13" name="yes" sourceRef="Gw_WristbandOK" targetRef="Gw_WristbandMerge"/>
    <bpmn:sequenceFlow id="Flow_A14" name="no" sourceRef="Gw_WristbandOK" targetRef="Gw_Reject2"/>
    <bpmn:sequenceFlow id="Flow_A15" sourceRef="Gw_WristbandMerge" targetRef="Task_SecurityCheck"/>
    <bpmn:sequenceFlow id="Flow_A16" sourceRef="Task_SecurityCheck" targetRef="Gw_BagFlagged"/>
    <bpmn:sequenceFlow id="Flow_A17" name="no" sourceRef="Gw_BagFlagged" targetRef="Gw_SecurityMerge"/>
    <bpmn:sequenceFlow id="Flow_A18" name="yes" sourceRef="Gw_BagFlagged" targetRef="Task_AdditionalScreening"/>
    <bpmn:sequenceFlow id="Flow_A19" sourceRef="Task_AdditionalScreening" targetRef="Gw_Cleared"/>
    <bpmn:sequenceFlow id="Flow_A20" name="yes" sourceRef="Gw_Cleared" targetRef="Gw_SecurityMerge"/>
    <bpmn:sequenceFlow id="Flow_A21" name="no" sourceRef="Gw_Cleared" targetRef="Gw_Reject3"/>
    <bpmn:sequenceFlow id="Flow_A22" sourceRef="Gw_SecurityMerge" targetRef="Task_EntryComplete"/>
    <bpmn:sequenceFlow id="Flow_A23" sourceRef="Task_EntryComplete" targetRef="End_Admitted"/>
    <bpmn:sequenceFlow id="Flow_A24" sourceRef="Gw_Reject1" targetRef="Gw_Reject2"/>
    <bpmn:sequenceFlow id="Flow_A25" sourceRef="Gw_Reject2" targetRef="Gw_Reject3"/>
    <bpmn:sequenceFlow id="Flow_A26" sourceRef="Gw_Reject3" targetRef="Task_EntryRejected"/>
    <bpmn:sequenceFlow id="Flow_A27" sourceRef="Task_EntryRejected" targetRef="End_Refused"/>
    <bpmn:dataObject id="DataObject_DataObject_Credential"/>
    <bpmn:dataObjectReference id="DataObject_Credential" name="Mobile ticket / wristband + photo ID" dataObjectRef="DataObject_DataObject_Credential"/>
    <bpmn:dataObject id="DataObject_DataObject_ProhibitedList"/>
    <bpmn:dataObjectReference id="DataObject_ProhibitedList" name="Prohibited items list" dataObjectRef="DataObject_DataObject_ProhibitedList"/>
    <bpmn:textAnnotation id="Note_PooledLanes">
      <bpmn:text>One serpentine queue feeds 3 identical staffed lanes (gate_id NG-L1..L3), FCFS. This is ONE pooled service station, not a parallel split: each attendee uses exactly one lane.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_PooledLanes" associationDirection="None" sourceRef="Task_TicketVerification" targetRef="Note_PooledLanes"/>
    <bpmn:textAnnotation id="Note_JoinQueue">
      <bpmn:text>Join Entry Queue = observation when the attendee enters the serpentine. First entry: ticket + photo ID checked and wristband fitted at the lane; post-entry crowd movement is out of scope.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_JoinQueue" associationDirection="None" sourceRef="Task_JoinEntryQueue" targetRef="Note_JoinQueue"/>
    <bpmn:textAnnotation id="Note_Rejection">
      <bpmn:text>Entry Rejected is recorded by the decision owner: Ticket Support, Wristband Steward or Security Supervisor.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_Rejection" associationDirection="None" sourceRef="Task_EntryRejected" targetRef="Note_Rejection"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AudienceAsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_AudienceAsIs" bpmnElement="Collaboration_AudienceAsIs">
      <bpmndi:BPMNShape id="Participant_AudienceAsIs_di" bpmnElement="Participant_AudienceAsIs" isHorizontal="true">
        <dc:Bounds x="160" y="150" width="3077" height="1050"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Queue_di" bpmnElement="Lane_Queue" isHorizontal="true">
        <dc:Bounds x="190" y="150" width="3047" height="150"/>
      </bpmndi:BPMNShape>
