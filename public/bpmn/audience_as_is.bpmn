      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Attendee_di" bpmnElement="Participant_Attendee" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="3077" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Arrive_di" bpmnElement="Start_Arrive">
