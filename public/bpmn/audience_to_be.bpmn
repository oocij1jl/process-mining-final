<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_AudienceToBe" targetNamespace="https://processpilot.example/festival/AudienceToBe" exporter="generate_festival_logs.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_AudienceToBe">
    <bpmn:participant id="Participant_AudienceToBe" name="Audience Entry — North Gate (To-be candidate, not validated)" processRef="Process_AudienceToBe"/>
    <bpmn:participant id="Participant_Attendee" name="Attendee (external)"/>
    <bpmn:messageFlow id="MsgFlow_AttendeeJoins" name="Attendee enters queue" sourceRef="Participant_Attendee" targetRef="Task_JoinEntryQueue"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_AudienceToBe" name="Audience Entry &amp; Crowd Management (To-be candidate)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AudienceToBe">
      <bpmn:lane id="Lane_Rejection" name="Rejection Record">
        <bpmn:flowNodeRef>Gw_Reject1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reject2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Reject3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntryRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Refused</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Express" name="Express Wristband Lane">
        <bpmn:flowNodeRef>Task_WristbandCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_WristbandOK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Queue" name="Queue &amp; Entry Record">
        <bpmn:flowNodeRef>Start_Arrive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_JoinEntryQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_HasWristband</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EntryComplete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Admitted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TicketLane" name="Ticket Lanes (4 at peak)">
        <bpmn:flowNodeRef>Task_TicketVerification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ScanOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TicketMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_PathMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Support" name="Ticket Support Desk">
        <bpmn:flowNodeRef>Task_ManualTicketCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TicketValid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security" name="Security Screener">
        <bpmn:flowNodeRef>Task_SecurityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_BagFlagged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SecurityMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supervisor" name="Security Supervisor">
        <bpmn:flowNodeRef>Task_AdditionalScreening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Cleared</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Arrive" name="Attendee reaches entrance">
      <bpmn:outgoing>Flow_T01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Task_JoinEntryQueue" name="Join Entry Queue">
      <bpmn:incoming>Flow_T01</bpmn:incoming>
      <bpmn:outgoing>Flow_T02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gw_HasWristband" name="Already holds festival wristband?">
      <bpmn:incoming>Flow_T02</bpmn:incoming>
      <bpmn:outgoing>Flow_T03</bpmn:outgoing>
      <bpmn:outgoing>Flow_T04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_WristbandCheck" name="Wristband Check">
      <bpmn:incoming>Flow_T03</bpmn:incoming>
      <bpmn:outgoing>Flow_T05</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_WristbandOK" name="Wristband intact?">
      <bpmn:incoming>Flow_T05</bpmn:incoming>
      <bpmn:outgoing>Flow_T06</bpmn:outgoing>
      <bpmn:outgoing>Flow_T07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_TicketVerification" name="Ticket Verification">
      <bpmn:incoming>Flow_T04</bpmn:incoming>
      <bpmn:outgoing>Flow_T08</bpmn:outgoing>
      <bpmn:property id="Property_Task_TicketVerification" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_Credential_Task_TicketVerification">
        <bpmn:sourceRef>DataObject_Credential</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_TicketVerification</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_ScanOK" name="Credential scanned?">
      <bpmn:incoming>Flow_T08</bpmn:incoming>
      <bpmn:outgoing>Flow_T09</bpmn:outgoing>
      <bpmn:outgoing>Flow_T10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManualTicketCheck" name="Manual Ticket Check">
      <bpmn:incoming>Flow_T10</bpmn:incoming>
      <bpmn:outgoing>Flow_T11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_TicketValid" name="Ticket valid?">
      <bpmn:incoming>Flow_T11</bpmn:incoming>
      <bpmn:outgoing>Flow_T12</bpmn:outgoing>
      <bpmn:outgoing>Flow_T13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_TicketMerge" name="">
      <bpmn:incoming>Flow_T09</bpmn:incoming>
      <bpmn:incoming>Flow_T12</bpmn:incoming>
      <bpmn:outgoing>Flow_T14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_PathMerge" name="">
      <bpmn:incoming>Flow_T06</bpmn:incoming>
      <bpmn:incoming>Flow_T14</bpmn:incoming>
      <bpmn:outgoing>Flow_T15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_SecurityCheck" name="Security Check">
      <bpmn:incoming>Flow_T15</bpmn:incoming>
      <bpmn:outgoing>Flow_T16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_BagFlagged" name="Bag flagged?">
      <bpmn:incoming>Flow_T16</bpmn:incoming>
      <bpmn:outgoing>Flow_T17</bpmn:outgoing>
      <bpmn:outgoing>Flow_T18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_AdditionalScreening" name="Additional Screening">
      <bpmn:incoming>Flow_T18</bpmn:incoming>
      <bpmn:outgoing>Flow_T19</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_Cleared" name="Cleared?">
      <bpmn:incoming>Flow_T19</bpmn:incoming>
      <bpmn:outgoing>Flow_T20</bpmn:outgoing>
      <bpmn:outgoing>Flow_T21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_SecurityMerge" name="">
      <bpmn:incoming>Flow_T17</bpmn:incoming>
      <bpmn:incoming>Flow_T20</bpmn:incoming>
      <bpmn:outgoing>Flow_T22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_EntryComplete" name="Entry Complete">
      <bpmn:incoming>Flow_T22</bpmn:incoming>
      <bpmn:outgoing>Flow_T23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Admitted" name="Admitted">
      <bpmn:incoming>Flow_T23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Reject1" name="">
      <bpmn:incoming>Flow_T07</bpmn:incoming>
      <bpmn:outgoing>Flow_T24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Reject2" name="">
      <bpmn:incoming>Flow_T13</bpmn:incoming>
      <bpmn:incoming>Flow_T24</bpmn:incoming>
      <bpmn:outgoing>Flow_T25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_Reject3" name="">
      <bpmn:incoming>Flow_T21</bpmn:incoming>
      <bpmn:incoming>Flow_T25</bpmn:incoming>
      <bpmn:outgoing>Flow_T26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EntryRejected" name="Entry Rejected">
      <bpmn:incoming>Flow_T26</bpmn:incoming>
      <bpmn:outgoing>Flow_T27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Refused" name="Entry refused">
      <bpmn:incoming>Flow_T27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_T01" sourceRef="Start_Arrive" targetRef="Task_JoinEntryQueue"/>
    <bpmn:sequenceFlow id="Flow_T02" sourceRef="Task_JoinEntryQueue" targetRef="Gw_HasWristband"/>
    <bpmn:sequenceFlow id="Flow_T03" name="yes (express)" sourceRef="Gw_HasWristband" targetRef="Task_WristbandCheck"/>
    <bpmn:sequenceFlow id="Flow_T04" name="no" sourceRef="Gw_HasWristband" targetRef="Task_TicketVerification"/>
    <bpmn:sequenceFlow id="Flow_T05" sourceRef="Task_WristbandCheck" targetRef="Gw_WristbandOK"/>
    <bpmn:sequenceFlow id="Flow_T06" name="yes" sourceRef="Gw_WristbandOK" targetRef="Gw_PathMerge"/>
    <bpmn:sequenceFlow id="Flow_T07" name="no" sourceRef="Gw_WristbandOK" targetRef="Gw_Reject1"/>
    <bpmn:sequenceFlow id="Flow_T08" sourceRef="Task_TicketVerification" targetRef="Gw_ScanOK"/>
    <bpmn:sequenceFlow id="Flow_T09" name="yes" sourceRef="Gw_ScanOK" targetRef="Gw_TicketMerge"/>
    <bpmn:sequenceFlow id="Flow_T10" name="no" sourceRef="Gw_ScanOK" targetRef="Task_ManualTicketCheck"/>
    <bpmn:sequenceFlow id="Flow_T11" sourceRef="Task_ManualTicketCheck" targetRef="Gw_TicketValid"/>
    <bpmn:sequenceFlow id="Flow_T12" name="yes" sourceRef="Gw_TicketValid" targetRef="Gw_TicketMerge"/>
    <bpmn:sequenceFlow id="Flow_T13" name="no" sourceRef="Gw_TicketValid" targetRef="Gw_Reject2"/>
    <bpmn:sequenceFlow id="Flow_T14" sourceRef="Gw_TicketMerge" targetRef="Gw_PathMerge"/>
    <bpmn:sequenceFlow id="Flow_T15" sourceRef="Gw_PathMerge" targetRef="Task_SecurityCheck"/>
    <bpmn:sequenceFlow id="Flow_T16" sourceRef="Task_SecurityCheck" targetRef="Gw_BagFlagged"/>
    <bpmn:sequenceFlow id="Flow_T17" name="no" sourceRef="Gw_BagFlagged" targetRef="Gw_SecurityMerge"/>
    <bpmn:sequenceFlow id="Flow_T18" name="yes" sourceRef="Gw_BagFlagged" targetRef="Task_AdditionalScreening"/>
    <bpmn:sequenceFlow id="Flow_T19" sourceRef="Task_AdditionalScreening" targetRef="Gw_Cleared"/>
    <bpmn:sequenceFlow id="Flow_T20" name="yes" sourceRef="Gw_Cleared" targetRef="Gw_SecurityMerge"/>
    <bpmn:sequenceFlow id="Flow_T21" name="no" sourceRef="Gw_Cleared" targetRef="Gw_Reject3"/>
    <bpmn:sequenceFlow id="Flow_T22" sourceRef="Gw_SecurityMerge" targetRef="Task_EntryComplete"/>
    <bpmn:sequenceFlow id="Flow_T23" sourceRef="Task_EntryComplete" targetRef="End_Admitted"/>
    <bpmn:sequenceFlow id="Flow_T24" sourceRef="Gw_Reject1" targetRef="Gw_Reject2"/>
    <bpmn:sequenceFlow id="Flow_T25" sourceRef="Gw_Reject2" targetRef="Gw_Reject3"/>
    <bpmn:sequenceFlow id="Flow_T26" sourceRef="Gw_Reject3" targetRef="Task_EntryRejected"/>
    <bpmn:sequenceFlow id="Flow_T27" sourceRef="Task_EntryRejected" targetRef="End_Refused"/>
    <bpmn:dataObject id="DataObject_DataObject_Credential"/>
    <bpmn:dataObjectReference id="DataObject_Credential" name="Mobile ticket + photo ID" dataObjectRef="DataObject_DataObject_Credential"/>
    <bpmn:textAnnotation id="Note_ToBe">
      <bpmn:text>To-be CANDIDATE. (1) Capacity: 4 staffed ticket lanes 12:00-13:00 (quantified only as a server-count what-if). (2) Structure: wristband holders (re-entry / multi-day) bypass the ticket lanes via an express Wristband Check lane (not simulated by the engine). Manual checks stay off-lane.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_ToBe" associationDirection="None" sourceRef="Gw_HasWristband" targetRef="Note_ToBe"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AudienceToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_AudienceToBe" bpmnElement="Collaboration_AudienceToBe">
