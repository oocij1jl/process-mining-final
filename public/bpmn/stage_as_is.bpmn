<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_StageAsIs" targetNamespace="https://processpilot.example/festival/StageAsIs" exporter="generate_festival_logs.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_StageAsIs">
    <bpmn:participant id="Participant_StageAsIs" name="Stage &amp; Technical Operations — per performance (As-is)" processRef="Process_StageAsIs"/>
    <bpmn:participant id="Participant_Artist" name="Artist / Tour Crew (external)"/>
    <bpmn:participant id="Participant_Equipment" name="Equipment &amp; Technical Readiness (see equipment_as_is.bpmn)"/>
    <bpmn:messageFlow id="MsgFlow_ArtistArrives" name="Artist crew &amp; gear at stage" sourceRef="Participant_Artist" targetRef="Task_StageHandover"/>
    <bpmn:messageFlow id="MsgFlow_WalkOn" name="Walk-on cue" sourceRef="Task_PerformanceStart" targetRef="Participant_Artist"/>
    <bpmn:messageFlow id="MsgFlow_EquipmentReady" name="Equipment Ready notice (per linked request)" sourceRef="Participant_Equipment" targetRef="Task_StageSetup"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_StageAsIs" name="Stage &amp; Technical Operations (As-is)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_StageAsIs">
      <bpmn:lane id="Lane_StageManager" name="Stage Manager">
        <bpmn:flowNodeRef>Start_Changeover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StageHandover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ReadyMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StageReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformanceStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PerformanceEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PerformanceDone</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backline" name="Backline Technician">
        <bpmn:flowNodeRef>Task_StageSetup</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Monitor" name="Monitor Engineer">
        <bpmn:flowNodeRef>Gw_LineCheckNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LineCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_LineCheckMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_FOH" name="FOH Engineer">
        <bpmn:flowNodeRef>Task_TechnicalCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_TechCheckPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TechnicalRecheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RecheckPassed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IssueOwner" name="Issue Owner (by issue type)">
        <bpmn:flowNodeRef>Gw_TroubleshootMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TechnicalTroubleshooting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Changeover" name="Changeover slot begins">
      <bpmn:outgoing>Flow_S01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_StageHandover" name="Stage Handover">
      <bpmn:incoming>Flow_S01</bpmn:incoming>
      <bpmn:outgoing>Flow_S02</bpmn:outgoing>
      <bpmn:property id="Property_Task_StageHandover" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_RunOfShow_Task_StageHandover">
        <bpmn:sourceRef>DataObject_RunOfShow</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_StageHandover</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_StageSetup" name="Stage Setup">
      <bpmn:incoming>Flow_S02</bpmn:incoming>
      <bpmn:outgoing>Flow_S03</bpmn:outgoing>
      <bpmn:property id="Property_Task_StageSetup" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_StagePlot_Task_StageSetup">
        <bpmn:sourceRef>DataObject_StagePlot</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_StageSetup</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_LineCheckNeeded" name="Line check performed?">
      <bpmn:incoming>Flow_S03</bpmn:incoming>
      <bpmn:outgoing>Flow_S04</bpmn:outgoing>
      <bpmn:outgoing>Flow_S05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_LineCheck" name="Line Check">
      <bpmn:incoming>Flow_S04</bpmn:incoming>
      <bpmn:outgoing>Flow_S06</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_LineCheckMerge" name="">
      <bpmn:incoming>Flow_S05</bpmn:incoming>
      <bpmn:incoming>Flow_S06</bpmn:incoming>
      <bpmn:outgoing>Flow_S07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_TechnicalCheck" name="Technical Check">
      <bpmn:incoming>Flow_S07</bpmn:incoming>
      <bpmn:outgoing>Flow_S08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_TechCheckPassed" name="Technical check passed?">
      <bpmn:incoming>Flow_S08</bpmn:incoming>
      <bpmn:outgoing>Flow_S09</bpmn:outgoing>
      <bpmn:outgoing>Flow_S10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_TroubleshootMerge" name="">
      <bpmn:incoming>Flow_S10</bpmn:incoming>
      <bpmn:incoming>Flow_S15</bpmn:incoming>
      <bpmn:outgoing>Flow_S11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_TechnicalTroubleshooting" name="Technical Troubleshooting">
      <bpmn:incoming>Flow_S11</bpmn:incoming>
      <bpmn:outgoing>Flow_S12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_TechnicalRecheck" name="Technical Recheck">
      <bpmn:incoming>Flow_S12</bpmn:incoming>
      <bpmn:outgoing>Flow_S13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_RecheckPassed" name="Recheck passed?">
      <bpmn:incoming>Flow_S13</bpmn:incoming>
      <bpmn:outgoing>Flow_S14</bpmn:outgoing>
      <bpmn:outgoing>Flow_S15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_ReadyMerge" name="">
      <bpmn:incoming>Flow_S09</bpmn:incoming>
      <bpmn:incoming>Flow_S14</bpmn:incoming>
      <bpmn:outgoing>Flow_S16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_StageReady" name="Stage Ready">
      <bpmn:incoming>Flow_S16</bpmn:incoming>
      <bpmn:outgoing>Flow_S17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_PerformanceStart" name="Performance Start">
      <bpmn:incoming>Flow_S17</bpmn:incoming>
      <bpmn:outgoing>Flow_S18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_PerformanceEnd" name="Performance End">
      <bpmn:incoming>Flow_S18</bpmn:incoming>
      <bpmn:outgoing>Flow_S19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_PerformanceDone" name="Performance completed">
      <bpmn:incoming>Flow_S19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_S01" sourceRef="Start_Changeover" targetRef="Task_StageHandover"/>
    <bpmn:sequenceFlow id="Flow_S02" sourceRef="Task_StageHandover" targetRef="Task_StageSetup"/>
    <bpmn:sequenceFlow id="Flow_S03" sourceRef="Task_StageSetup" targetRef="Gw_LineCheckNeeded"/>
    <bpmn:sequenceFlow id="Flow_S04" name="yes" sourceRef="Gw_LineCheckNeeded" targetRef="Task_LineCheck"/>
    <bpmn:sequenceFlow id="Flow_S05" name="no" sourceRef="Gw_LineCheckNeeded" targetRef="Gw_LineCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_S06" sourceRef="Task_LineCheck" targetRef="Gw_LineCheckMerge"/>
    <bpmn:sequenceFlow id="Flow_S07" sourceRef="Gw_LineCheckMerge" targetRef="Task_TechnicalCheck"/>
    <bpmn:sequenceFlow id="Flow_S08" sourceRef="Task_TechnicalCheck" targetRef="Gw_TechCheckPassed"/>
    <bpmn:sequenceFlow id="Flow_S09" name="yes" sourceRef="Gw_TechCheckPassed" targetRef="Gw_ReadyMerge"/>
    <bpmn:sequenceFlow id="Flow_S10" name="no" sourceRef="Gw_TechCheckPassed" targetRef="Gw_TroubleshootMerge"/>
    <bpmn:sequenceFlow id="Flow_S11" sourceRef="Gw_TroubleshootMerge" targetRef="Task_TechnicalTroubleshooting"/>
    <bpmn:sequenceFlow id="Flow_S12" sourceRef="Task_TechnicalTroubleshooting" targetRef="Task_TechnicalRecheck"/>
    <bpmn:sequenceFlow id="Flow_S13" sourceRef="Task_TechnicalRecheck" targetRef="Gw_RecheckPassed"/>
    <bpmn:sequenceFlow id="Flow_S14" name="yes" sourceRef="Gw_RecheckPassed" targetRef="Gw_ReadyMerge"/>
    <bpmn:sequenceFlow id="Flow_S15" name="no" sourceRef="Gw_RecheckPassed" targetRef="Gw_TroubleshootMerge"/>
    <bpmn:sequenceFlow id="Flow_S16" sourceRef="Gw_ReadyMerge" targetRef="Task_StageReady"/>
    <bpmn:sequenceFlow id="Flow_S17" sourceRef="Task_StageReady" targetRef="Task_PerformanceStart"/>
    <bpmn:sequenceFlow id="Flow_S18" sourceRef="Task_PerformanceStart" targetRef="Task_PerformanceEnd"/>
    <bpmn:sequenceFlow id="Flow_S19" sourceRef="Task_PerformanceEnd" targetRef="End_PerformanceDone"/>
    <bpmn:dataObject id="DataObject_DataObject_RunOfShow"/>
    <bpmn:dataObjectReference id="DataObject_RunOfShow" name="Run-of-show (scheduled_start)" dataObjectRef="DataObject_DataObject_RunOfShow"/>
    <bpmn:dataObject id="DataObject_DataObject_StagePlot"/>
    <bpmn:dataObjectReference id="DataObject_StagePlot" name="Stage plot / technical rider" dataObjectRef="DataObject_DataObject_StagePlot"/>
    <bpmn:textAnnotation id="Note_LineCheck">
      <bpmn:text>Line Check only for band acts; skipped for DJ/playback sets and, with p=0.6, when setup ends inside the compressed-changeover threshold. Headliner full soundcheck happens earlier in the day (outside this case).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_LineCheck" associationDirection="None" sourceRef="Gw_LineCheckMerge" targetRef="Note_LineCheck"/>
    <bpmn:textAnnotation id="Note_IssueOwner">
      <bpmn:text>Issue owner by issue_type: monitor_mix / wireless_rf -&gt; Monitor Engineer; signal_path -&gt; Backline Tech; lighting_cue -&gt; Lighting Operator. Recheck loop max 3.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_IssueOwner" associationDirection="None" sourceRef="Task_TechnicalTroubleshooting" targetRef="Note_IssueOwner"/>
    <bpmn:textAnnotation id="Note_Setup">
      <bpmn:text>Setup cannot complete before all linked equipment is Equipment Ready (+2-5 min install).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_Setup" associationDirection="None" sourceRef="Task_StageSetup" targetRef="Note_Setup"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_StageAsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_StageAsIs" bpmnElement="Collaboration_StageAsIs">
