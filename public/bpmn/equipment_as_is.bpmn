<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_EquipmentAsIs" targetNamespace="https://processpilot.example/festival/EquipmentAsIs" exporter="generate_festival_logs.py" exporterVersion="1.0.0">
  <bpmn:collaboration id="Collaboration_EquipmentAsIs">
    <bpmn:participant id="Participant_EquipmentAsIs" name="Equipment &amp; Technical Readiness — per equipment request (As-is)" processRef="Process_EquipmentAsIs"/>
    <bpmn:participant id="Participant_Artist" name="Artist / Tour Management (external)"/>
    <bpmn:participant id="Participant_Stage" name="Stage &amp; Technical Operations (see stage_as_is.bpmn)"/>
    <bpmn:messageFlow id="MsgFlow_Rider" name="Technical rider / backline request" sourceRef="Participant_Artist" targetRef="Task_EquipmentRequested"/>
    <bpmn:messageFlow id="MsgFlow_ReadyNotice" name="Equipment Ready notice" sourceRef="Task_EquipmentReady" targetRef="Participant_Stage"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_EquipmentAsIs" name="Equipment &amp; Technical Readiness (As-is)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EquipmentAsIs">
      <bpmn:lane id="Lane_Coordinator" name="Production Coordinator">
        <bpmn:flowNodeRef>Start_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EquipmentRequested</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EquipmentManager" name="Equipment Manager">
        <bpmn:flowNodeRef>Task_AvailabilityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubstituteSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_AllocMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EquipmentAllocation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Logistics Crew">
        <bpmn:flowNodeRef>Task_EquipmentTransport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QC" name="Backline QC Technician">
        <bpmn:flowNodeRef>Gw_InspectMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PreUseInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_InspectionPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InspectionRework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EquipmentReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Need" name="Backline need for a performance">
      <bpmn:outgoing>Flow_E01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_EquipmentRequested" name="Equipment Requested">
      <bpmn:incoming>Flow_E01</bpmn:incoming>
      <bpmn:outgoing>Flow_E02</bpmn:outgoing>
      <bpmn:property id="Property_Task_EquipmentRequested" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_Rider_Task_EquipmentRequested">
        <bpmn:sourceRef>DataObject_Rider</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_EquipmentRequested</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AvailabilityCheck" name="Availability Check">
      <bpmn:incoming>Flow_E02</bpmn:incoming>
      <bpmn:outgoing>Flow_E03</bpmn:outgoing>
      <bpmn:property id="Property_Task_AvailabilityCheck" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_DataObject_AssetRegister_Task_AvailabilityCheck">
        <bpmn:sourceRef>DataObject_AssetRegister</bpmn:sourceRef>
        <bpmn:targetRef>Property_Task_AvailabilityCheck</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Available" name="Requested model free for the window?">
      <bpmn:incoming>Flow_E03</bpmn:incoming>
      <bpmn:outgoing>Flow_E04</bpmn:outgoing>
      <bpmn:outgoing>Flow_E05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SubstituteSearch" name="Substitute Search">
      <bpmn:incoming>Flow_E05</bpmn:incoming>
      <bpmn:outgoing>Flow_E06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_AllocMerge" name="">
      <bpmn:incoming>Flow_E04</bpmn:incoming>
      <bpmn:incoming>Flow_E06</bpmn:incoming>
      <bpmn:outgoing>Flow_E07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EquipmentAllocation" name="Equipment Allocation">
      <bpmn:incoming>Flow_E07</bpmn:incoming>
      <bpmn:outgoing>Flow_E08</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Task_EquipmentAllocation_DataObject_AllocationRecord">
        <bpmn:targetRef>DataObject_AllocationRecord</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_EquipmentTransport" name="Equipment Transport">
      <bpmn:incoming>Flow_E08</bpmn:incoming>
      <bpmn:outgoing>Flow_E09</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_InspectMerge" name="">
      <bpmn:incoming>Flow_E09</bpmn:incoming>
      <bpmn:incoming>Flow_E14</bpmn:incoming>
      <bpmn:outgoing>Flow_E10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_PreUseInspection" name="Pre-use Inspection">
      <bpmn:incoming>Flow_E10</bpmn:incoming>
      <bpmn:outgoing>Flow_E11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_InspectionPassed" name="Inspection passed?">
      <bpmn:incoming>Flow_E11</bpmn:incoming>
      <bpmn:outgoing>Flow_E12</bpmn:outgoing>
      <bpmn:outgoing>Flow_E13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_InspectionRework" name="Inspection Rework">
      <bpmn:incoming>Flow_E13</bpmn:incoming>
      <bpmn:outgoing>Flow_E14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="Task_EquipmentReady" name="Equipment Ready">
      <bpmn:incoming>Flow_E12</bpmn:incoming>
      <bpmn:outgoing>Flow_E15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Ready" name="Equipment ready at stage">
      <bpmn:incoming>Flow_E15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_E01" sourceRef="Start_Need" targetRef="Task_EquipmentRequested"/>
    <bpmn:sequenceFlow id="Flow_E02" sourceRef="Task_EquipmentRequested" targetRef="Task_AvailabilityCheck"/>
    <bpmn:sequenceFlow id="Flow_E03" sourceRef="Task_AvailabilityCheck" targetRef="Gw_Available"/>
    <bpmn:sequenceFlow id="Flow_E04" name="yes" sourceRef="Gw_Available" targetRef="Gw_AllocMerge"/>
    <bpmn:sequenceFlow id="Flow_E05" name="no" sourceRef="Gw_Available" targetRef="Task_SubstituteSearch"/>
    <bpmn:sequenceFlow id="Flow_E06" sourceRef="Task_SubstituteSearch" targetRef="Gw_AllocMerge"/>
    <bpmn:sequenceFlow id="Flow_E07" sourceRef="Gw_AllocMerge" targetRef="Task_EquipmentAllocation"/>
    <bpmn:sequenceFlow id="Flow_E08" sourceRef="Task_EquipmentAllocation" targetRef="Task_EquipmentTransport"/>
    <bpmn:sequenceFlow id="Flow_E09" sourceRef="Task_EquipmentTransport" targetRef="Gw_InspectMerge"/>
    <bpmn:sequenceFlow id="Flow_E10" sourceRef="Gw_InspectMerge" targetRef="Task_PreUseInspection"/>
    <bpmn:sequenceFlow id="Flow_E11" sourceRef="Task_PreUseInspection" targetRef="Gw_InspectionPassed"/>
    <bpmn:sequenceFlow id="Flow_E12" name="yes" sourceRef="Gw_InspectionPassed" targetRef="Task_EquipmentReady"/>
    <bpmn:sequenceFlow id="Flow_E13" name="no" sourceRef="Gw_InspectionPassed" targetRef="Task_InspectionRework"/>
    <bpmn:sequenceFlow id="Flow_E14" sourceRef="Task_InspectionRework" targetRef="Gw_InspectMerge"/>
    <bpmn:sequenceFlow id="Flow_E15" sourceRef="Task_EquipmentReady" targetRef="End_Ready"/>
    <bpmn:dataObject id="DataObject_DataObject_AssetRegister"/>
    <bpmn:dataObjectReference id="DataObject_AssetRegister" name="Asset register (house backline)" dataObjectRef="DataObject_DataObject_AssetRegister"/>
    <bpmn:dataObject id="DataObject_DataObject_AllocationRecord"/>
    <bpmn:dataObjectReference id="DataObject_AllocationRecord" name="Allocation record (asset_id)" dataObjectRef="DataObject_DataObject_AllocationRecord"/>
    <bpmn:dataObject id="DataObject_DataObject_Rider"/>
    <bpmn:dataObjectReference id="DataObject_Rider" name="Technical rider / input list" dataObjectRef="DataObject_DataObject_Rider"/>
    <bpmn:textAnnotation id="Note_Substitute">
      <bpmn:text>Substitute = alternative model or rental asset (ALT-*) when the house pool is booked for the window or the rider model is unavailable.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_Substitute" associationDirection="None" sourceRef="Task_SubstituteSearch" targetRef="Note_Substitute"/>
    <bpmn:textAnnotation id="Note_Deadline">
      <bpmn:text>On time = Equipment Ready &lt;= required_ready_at (planned changeover start of the linked performance, festival_id + performance_id).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_Deadline" associationDirection="None" sourceRef="Task_EquipmentReady" targetRef="Note_Deadline"/>
    <bpmn:textAnnotation id="Note_Transport">
      <bpmn:text>Transport time depends on destination stage (MAIN / RIVER / CLUB).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Note_Transport" associationDirection="None" sourceRef="Task_EquipmentTransport" targetRef="Note_Transport"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_EquipmentAsIs">
    <bpmndi:BPMNPlane id="BPMNPlane_EquipmentAsIs" bpmnElement="Collaboration_EquipmentAsIs">
